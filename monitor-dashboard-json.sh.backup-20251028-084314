#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

BOT_PID=$(pgrep -f "node.*start-shadow" | head -1)
LOG_FILES=$(ls -t logs/combined-*.log* 2>/dev/null | grep -v "\.gz$" | head -10)

get_virtual_balances() {
    [ -f data/virtual_balances.json ] && cat data/virtual_balances.json || echo '{"usdt":36000,"bnb":22}'
}

get_current_price() {
    [ -n "$LOG_FILES" ] && grep -h "currentPrice" $LOG_FILES 2>/dev/null | tail -1 | grep -oE "0\.[0-9]+" | head -1 | awk '{print 1/$1}' || echo "1150"
}

get_portfolio_data() {
    local BALANCES=$(get_virtual_balances)
    local USDT=$(echo "$BALANCES" | grep -oE '[0-9]+' | head -1)
    local BNB=$(echo "$BALANCES" | grep -oE '[0-9]+' | tail -1)
    local PRICE=$(get_current_price)

    USDT=${USDT:-36000}
    BNB=${BNB:-22}
    PRICE=${PRICE:-1150}

    local BNB_VALUE=$(echo "$BNB * $PRICE" | bc 2>/dev/null || echo "25300")
    local TOTAL=$(echo "$USDT + $BNB_VALUE" | bc 2>/dev/null || echo "61300")
    local BNB_PCT=$(echo "scale=1; ($BNB_VALUE * 100) / $TOTAL" | bc 2>/dev/null || echo "40")
    local PNL=$(echo "$TOTAL - 60000" | bc 2>/dev/null || echo "1300")
    local PNL_PCT=$(echo "scale=2; ($PNL * 100) / 60000" | bc 2>/dev/null || echo "2")

    echo "$TOTAL|$USDT|$BNB|$BNB_VALUE|$BNB_PCT|$PRICE|$PNL|$PNL_PCT"
}

get_trading_stats() {
    local DECISIONS=0
    local ENTRIES=0
    local COMPLETED=0
    local WINS=0

    # Count from logs - simple and safe
    [ -n "$LOG_FILES" ] && DECISIONS=$(cat $LOG_FILES 2>/dev/null | grep -c "Trading decision" 2>/dev/null || echo "0")

    # Count from JSON - simple and safe
    [ -f data/shadow_trades.json ] && ENTRIES=$(grep -c '"action"' data/shadow_trades.json 2>/dev/null || echo "0")
    [ -f data/shadow_trades.json ] && COMPLETED=$(grep -c '"status":"closed"' data/shadow_trades.json 2>/dev/null || echo "0")
    [ -f data/shadow_trades.json ] && WINS=$(grep '"status":"closed"' data/shadow_trades.json 2>/dev/null | grep -c '"profit":[1-9]' || echo "0")

    local LOSSES=$((COMPLETED - WINS))
    local WIN_RATE="0.0"
    [ $COMPLETED -gt 0 ] 2>/dev/null && WIN_RATE=$(echo "scale=1; ($WINS * 100) / $COMPLETED" | bc 2>/dev/null || echo "0.0")

    echo "$DECISIONS|$ENTRIES|0|$COMPLETED|$WINS|$LOSSES|$WIN_RATE"
}

while true; do
    clear

    PORTFOLIO=$(get_portfolio_data)
    IFS='|' read -r TOTAL USDT BNB BNB_VALUE BNB_PCT PRICE PNL PNL_PCT <<< "$PORTFOLIO"

    TRADING=$(get_trading_stats)
    IFS='|' read -r DECISIONS ENTRIES ACTIVE COMPLETED WINS LOSSES WIN_RATE <<< "$TRADING"

    [ $(echo "$PNL > 0" | bc 2>/dev/null || echo "0") -eq 1 ] && PNL_COLOR=$GREEN PNL_SYM="+" || PNL_COLOR=$RED PNL_SYM=""

    echo "════════════════════════════════════════════════════════════════"
    echo "          BSC TRADING BOT - ENHANCED DASHBOARD"
    echo "════════════════════════════════════════════════════════════════"
    date '+%Y-%m-%d %H:%M:%S'
    echo ""

    echo "[1] BOT STATUS"
    echo "────────────────────────────────────────────────────────────────"
    if [ -n "$BOT_PID" ]; then
        echo "  Status:      ● RUNNING"
        echo "  PID:         $BOT_PID"
        echo "  Uptime:      $(ps -p $BOT_PID -o etime= 2>/dev/null | tr -d ' ')"
        echo "  Memory:      $(ps -p $BOT_PID -o rss= 2>/dev/null | awk '{printf "%.1fMB", $1/1024}')"
    else
        echo "  Status:      ○ STOPPED"
    fi
    echo ""

    echo "[2] PORTFOLIO & P&L"
    echo "────────────────────────────────────────────────────────────────"
    echo "  Total Value:  \$$TOTAL"
    echo -e "  P&L:          ${PNL_COLOR}\$${PNL_SYM}$PNL (${PNL_SYM}${PNL_PCT}%)${NC}"
    echo "  USDT:         \$$USDT ($(echo "100 - $BNB_PCT" | bc)%)"
    echo "  BNB:          $BNB (\$$BNB_VALUE - ${BNB_PCT}%)"
    echo "  BNB Price:    \$$PRICE"
    echo ""

    echo "[3] TRADING ACTIVITY"
    echo "────────────────────────────────────────────────────────────────"
    echo "  Total Decisions:  $DECISIONS"
    echo "  Shadow Entries:   $ENTRIES"
    echo "  Active Positions: $ACTIVE"
    echo "  Completed Trades: $COMPLETED"
    echo "  ├─ Wins:          $WINS"
    echo "  ├─ Losses:        $LOSSES"
    echo "  └─ Win Rate:      ${WIN_RATE}%"
    echo ""

    echo "[4] MARKET CONDITIONS"
    echo "────────────────────────────────────────────────────────────────"
    REGIME=$([ -n "$LOG_FILES" ] && grep -h "REGIME.*Detected" $LOG_FILES 2>/dev/null | tail -1 | grep -oE "LOW|MEDIUM|HIGH|VERY_LOW" | head -1 || echo "UNKNOWN")
    VOL=$([ -n "$LOG_FILES" ] && grep -h "Volatility:" $LOG_FILES 2>/dev/null | tail -1 | grep -oE "[0-9]+\.[0-9]+" | head -1 || echo "0.00")
    echo "  Regime:      $REGIME"
    echo "  Volatility:  ${VOL}%"
    echo "  Mode:        👻 Shadow Trading"
    echo ""

    echo "[5] ENHANCEMENTS"
    echo "────────────────────────────────────────────────────────────────"
    [ -n "$LOG_FILES" ] && grep -hq "DYNAMIC-THRESHOLD" $LOG_FILES 2>/dev/null && echo "  Dynamic Thresholds: ✅ ACTIVE" || echo "  Dynamic Thresholds: ⏳ Waiting"
    echo "  Virtual Balance:    ✅ Fixed"
    echo ""

    echo "════════════════════════════════════════════════════════════════"
    echo "Dashboard: Enhanced | Bot: ${BOT_PID:-Stopped} | Refresh: 30s"
    echo "════════════════════════════════════════════════════════════════"

    sleep 30
done
