#!/bin/bash

# BSC Trading Bot - Enhanced Professional Dashboard
# Updates: Every 30 seconds
# Features: P&L tracking, positions, win/loss stats

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get bot PID
BOT_PID=$(pgrep -f "AdvancedTradingBot" | head -1)

# Get all log files (newest first)
get_log_files() {
    ls -t logs/combined-*.log* 2>/dev/null | grep -v "\.gz$" | head -10
}

LOG_FILES=$(get_log_files)

# Get virtual balances for P&L calculation
get_virtual_balances() {
    if [ -f data/virtual_balances.json ]; then
        cat data/virtual_balances.json
    else
        echo '{"usdt": 36000, "bnb": 22}'
    fi
}

# Get current price
get_current_price() {
    if [ -n "$LOG_FILES" ]; then
        PRICE=$(grep -h "currentPrice.*0.00" $LOG_FILES 2>/dev/null | tail -1 | grep -o "0\.[0-9]*" | head -1)
        if [ -n "$PRICE" ]; then
            # Convert from BNB/USDT to USDT/BNB
            echo "scale=2; 1 / $PRICE" | bc 2>/dev/null || echo "1150"
        else
            echo "1150"
        fi
    else
        echo "1150"
    fi
}

# Calculate portfolio value and P&L
get_portfolio_data() {
    BALANCES=$(get_virtual_balances)
    USDT=$(echo "$BALANCES" | grep -o '"usdt": [0-9.]*' | grep -o '[0-9.]*')
    BNB=$(echo "$BALANCES" | grep -o '"bnb": [0-9.]*' | grep -o '[0-9.]*')
    PRICE=$(get_current_price)

    # Calculate values
    BNB_VALUE=$(echo "scale=2; $BNB * $PRICE" | bc 2>/dev/null || echo "25300")
    TOTAL=$(echo "scale=2; $USDT + $BNB_VALUE" | bc 2>/dev/null || echo "61300")
    BNB_PCT=$(echo "scale=1; ($BNB_VALUE / $TOTAL) * 100" | bc 2>/dev/null || echo "41.3")

    # Calculate P&L from initial $60,000
    INITIAL=60000
    PNL=$(echo "scale=2; $TOTAL - $INITIAL" | bc 2>/dev/null || echo "0")
    PNL_PCT=$(echo "scale=2; ($PNL / $INITIAL) * 100" | bc 2>/dev/null || echo "0")

    echo "$TOTAL|$USDT|$BNB|$BNB_VALUE|$BNB_PCT|$PRICE|$PNL|$PNL_PCT"
}

# Get active positions from logs
get_active_positions() {
    if [ -n "$LOG_FILES" ]; then
        # Count active positions from recent logs
        POSITIONS=$(grep -h "📊 Monitoring.*active position" $LOG_FILES 2>/dev/null | tail -1 | grep -o "[0-9]* active" | grep -o "[0-9]*")
        echo "${POSITIONS:-0}"
    else
        echo "0"
    fi
}

# Get trading statistics
get_trading_stats() {
    # Total trading decisions
    TOTAL_DECISIONS=$(grep -h "Trading decision made" $LOG_FILES 2>/dev/null | wc -l | tr -d ' ')

    # Shadow entries
    if [ -f data/shadow_trades.json ]; then
        SHADOW_ENTRIES=$(grep -c '"action"' data/shadow_trades.json 2>/dev/null || echo "0")
    else
        SHADOW_ENTRIES=0
    fi

    # Active positions
    ACTIVE_POS=$(get_active_positions)

    # Completed trades (from database or logs)
    COMPLETED=0
    WINS=0
    LOSSES=0

    # Try to get from shadow trades if they have profit data
    if [ -f data/shadow_trades.json ]; then
        COMPLETED=$(grep -c '"status":"closed"' data/shadow_trades.json 2>/dev/null || echo "0")
        WINS=$(grep '"status":"closed"' data/shadow_trades.json 2>/dev/null | grep -c '"profit":[^-]' || echo "0")
        LOSSES=$(echo "$COMPLETED - $WINS" | bc 2>/dev/null || echo "0")
    fi

    # Calculate win rate
    if [ "$COMPLETED" -gt 0 ]; then
        WIN_RATE=$(echo "scale=1; ($WINS * 100) / $COMPLETED" | bc 2>/dev/null || echo "0")
    else
        WIN_RATE="0"
    fi

    echo "$TOTAL_DECISIONS|$SHADOW_ENTRIES|$ACTIVE_POS|$COMPLETED|$WINS|$LOSSES|$WIN_RATE"
}

# Get market regime
get_market_regime() {
    if [ -n "$LOG_FILES" ]; then
        REGIME=$(grep -h "\[REGIME\] Detected:" $LOG_FILES 2>/dev/null | tail -1 | grep -o "Detected: [A-Z_]*" | cut -d' ' -f2)
        echo "${REGIME:-UNKNOWN}"
    else
        echo "UNKNOWN"
    fi
}

# Get current volatility
get_volatility() {
    if [ -n "$LOG_FILES" ]; then
        VOL=$(grep -h "Volatility (4h):" $LOG_FILES 2>/dev/null | tail -1 | grep -o "[0-9.]*%" | grep -o "[0-9.]*")
        echo "${VOL:-0.00}"
    else
        echo "0.00"
    fi
}

# Main dashboard loop
while true; do
    clear

    # Get all data
    PORTFOLIO=$(get_portfolio_data)
    IFS='|' read -r TOTAL USDT BNB BNB_VALUE BNB_PCT PRICE PNL PNL_PCT <<< "$PORTFOLIO"

    TRADING=$(get_trading_stats)
    IFS='|' read -r DECISIONS ENTRIES ACTIVE_POS COMPLETED WINS LOSSES WIN_RATE <<< "$TRADING"

    REGIME=$(get_market_regime)
    VOLATILITY=$(get_volatility)

    # Determine P&L color
    if (( $(echo "$PNL > 0" | bc -l) )); then
        PNL_COLOR=$GREEN
        PNL_SYMBOL="+"
    else
        PNL_COLOR=$RED
        PNL_SYMBOL=""
    fi

    # Display dashboard
    echo "════════════════════════════════════════════════════════════════"
    echo "          BSC TRADING BOT - ENHANCED DASHBOARD"
    echo "════════════════════════════════════════════════════════════════"
    echo "$(date '+%Y-%m-%d %H:%M:%S') | Multi-File Analysis"
    echo ""

    echo "[1] BOT STATUS"
    echo "────────────────────────────────────────────────────────────────"
    if [ -n "$BOT_PID" ]; then
        echo "  Status:      ● RUNNING"
        echo "  PID:         $BOT_PID"
        UPTIME=$(ps -p $BOT_PID -o etime= 2>/dev/null | tr -d ' ')
        echo "  Uptime:      ${UPTIME:-N/A}"
        MEM=$(ps -p $BOT_PID -o rss= 2>/dev/null | awk '{printf "%.1fMB", $1/1024}')
        echo "  Memory:      ${MEM:-N/A}"
    else
        echo "  Status:      ○ STOPPED"
    fi
    echo ""

    echo "[2] PORTFOLIO & P&L"
    echo "────────────────────────────────────────────────────────────────"
    echo "  Total Value:  \$TOTAL"
    echo -e "  P&L:          ${PNL_COLOR}\${PNL_SYMBOL}$PNL (${PNL_SYMBOL}${PNL_PCT}%)${NC}"
    echo "  USDT:         \$USDT ($(echo "100 - $BNB_PCT" | bc)%)"
    echo "  BNB:          $BNB (\$BNB_VALUE - ${BNB_PCT}%)"
    echo "  BNB Price:    \$PRICE"
    echo ""

    echo "[3] TRADING ACTIVITY"
    echo "────────────────────────────────────────────────────────────────"
    echo "  Total Decisions:  $DECISIONS"
    echo "  Shadow Entries:   $ENTRIES"
    echo "  Active Positions: $ACTIVE_POS"
    echo "  Completed Trades: $COMPLETED"
    echo "  ├─ Wins:          $WINS"
    echo "  ├─ Losses:        $LOSSES"
    echo "  └─ Win Rate:      ${WIN_RATE}%"
    echo ""

    echo "[4] MARKET CONDITIONS"
    echo "────────────────────────────────────────────────────────────────"
    echo "  Regime:      $REGIME"
    echo "  Volatility:  ${VOLATILITY}%"
    echo "  Mode:        👻 Shadow Trading"
    echo ""

    echo "[5] ENHANCEMENTS"
    echo "────────────────────────────────────────────────────────────────"
    if [ -n "$LOG_FILES" ]; then
        DYNAMIC=$(grep -h "DYNAMIC-THRESHOLD" $LOG_FILES 2>/dev/null | tail -1)
        if [ -n "$DYNAMIC" ]; then
            echo "  Dynamic Thresholds: ✅ ACTIVE"
            REGIME_THRESH=$(echo "$DYNAMIC" | grep -o "Regime: [A-Z_]*" | cut -d' ' -f2)
            MIN_THRESH=$(echo "$DYNAMIC" | grep -o "Min: [0-9]*%" | grep -o "[0-9]*")
            echo "  Current Regime:     $REGIME_THRESH"
            echo "  Min Threshold:      ${MIN_THRESH}%"
        else
            echo "  Dynamic Thresholds: ⏳ Waiting"
        fi
    fi
    echo "  Virtual Balance:    ✅ Fixed"
    echo ""

    echo "════════════════════════════════════════════════════════════════"
    echo "Dashboard: Enhanced | Bot: ${BOT_PID:-Stopped} | Refresh: 30s"
    echo "════════════════════════════════════════════════════════════════"

    sleep 30
done
