#!/bin/bash

# BSC Trading Bot - Professional Dashboard with Multi-File Log Parsing

# Smart log file detection - GET ALL ROTATED FILES
get_all_log_files() {
    ls -t /Users/sheirraza/bsc-ranging-bot/logs/combined-*.log* 2>/dev/null | grep -v "\.gz$" | head -10
}

LOG_FILES=$(get_all_log_files)
LATEST_LOG=$(echo "$LOG_FILES" | head -1)

# Colors for professional output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GRAY='\033[0;37m'
NC='\033[0m' # No Color

# Professional JSON parsing function - reads from ALL log files
parse_json_value() {
    local pattern="$1"
    tail -100 $LOG_FILES 2>/dev/null | grep -E "$pattern" | tail -1 | python3 -c "
import sys, json, re
try:
    for line in sys.stdin:
        line = line.strip()
        if line:
            data = json.loads(line)
            message = data.get('message', '')
            match = re.search(r'$pattern', message)
            if match:
                print(match.group(1).strip())
                break
except Exception as e:
    pass
" 2>/dev/null
}

# Get numeric value from JSON
get_numeric_value() {
    local pattern="$1"
    local value=$(parse_json_value "$pattern")
    if [ -n "$value" ]; then
        echo "$value"
    else
        echo "0"
    fi
}

# Get text value from JSON
get_text_value() {
    local pattern="$1"
    local value=$(parse_json_value "$pattern")
    if [ -n "$value" ]; then
        echo "$value"
    else
        echo "N/A"
    fi
}

# Get bot process info
get_bot_info() {
    # Check for bot process (try both possible process names)
    local pid=$(pgrep -f "AdvancedTradingBot" | head -1)
    if [ -z "$pid" ]; then
        pid=$(pgrep -f "start-shadow-mode" | head -1)
    fi

    if [ -n "$pid" ]; then
        local uptime=$(ps -p $pid -o etime= 2>/dev/null | tr -d ' ' || echo "0:00")
        local memory=$(ps -p $pid -o rss= 2>/dev/null | awk '{printf "%.1f", $1/1024}' || echo "0")
        local cpu=$(ps -p $pid -o %cpu= 2>/dev/null | tr -d ' ' || echo "0")
        echo "$pid|$uptime|${memory}MB|${cpu}%"
    else
        echo "N/A|Stopped|0MB|0%"
    fi
}

# NEW: Get total trades from ALL log files
get_total_trades() {
    if [ -n "$LOG_FILES" ]; then
        grep -h "Trading decision" $LOG_FILES 2>/dev/null | wc -l | tr -d ' '
    else
        echo "0"
    fi
}

# NEW: Get active positions from latest entry across ALL log files
get_active_positions() {
    if [ -n "$LOG_FILES" ]; then
        local latest=$(grep -h "activePositions size:" $LOG_FILES 2>/dev/null | tail -1)
        if [ -n "$latest" ]; then
            echo "$latest" | grep -oE 'size: [0-9]+' | cut -d' ' -f2
        else
            echo "0"
        fi
    else
        echo "0"
    fi
}

# CORRECTED: Get ACTUAL trade stats from database + shadow trade entries
get_win_loss_stats() {
    local db_path="/Users/sheirraza/bsc-ranging-bot/data/trading_bot.db"
    local shadow_file="/Users/sheirraza/bsc-ranging-bot/data/shadow_trades.json"

    # Query completed trades from database
    if [ -f "$db_path" ]; then
        local db_result=$(sqlite3 "$db_path" "SELECT COUNT(*) as total, SUM(CASE WHEN profit_loss > 0 THEN 1 ELSE 0 END) as wins, SUM(CASE WHEN profit_loss < 0 THEN 1 ELSE 0 END) as losses FROM trades WHERE profit_loss IS NOT NULL;" 2>/dev/null)

        local total=$(echo "$db_result" | cut -d'|' -f1)
        local winning=$(echo "$db_result" | cut -d'|' -f2)
        local losing=$(echo "$db_result" | cut -d'|' -f3)

        # Handle empty/null results
        [ -z "$total" ] || [ "$total" = "" ] && total=0
        [ -z "$winning" ] || [ "$winning" = "" ] && winning=0
        [ -z "$losing" ] || [ "$losing" = "" ] && losing=0

        if [ "$total" -gt 0 ]; then
            local win_rate=$(echo "scale=1; ($winning * 100) / $total" | bc 2>/dev/null || echo "0")
            echo "$winning|$losing|$win_rate|$total"
        else
            echo "0|0|0|0"
        fi
    else
        echo "0|0|0|0"
    fi
}

# NEW: Get shadow trade entry count
get_shadow_entries() {
    local shadow_file="/Users/sheirraza/bsc-ranging-bot/data/shadow_trades.json"

    if [ -f "$shadow_file" ] && command -v jq >/dev/null 2>&1; then
        local count=$(jq 'length' "$shadow_file" 2>/dev/null || echo "0")
        echo "$count"
    else
        echo "0"
    fi
}

# Display log file diagnostic information
echo ""
echo "🔍 Log Files Found: $(echo "$LOG_FILES" | wc -l | tr -d ' ')"
if [ -n "$LATEST_LOG" ] && [ -f "$LATEST_LOG" ]; then
    echo "✅ Latest log: $(basename "$LATEST_LOG")"
    echo "📊 Size: $(du -h "$LATEST_LOG" 2>/dev/null | cut -f1)"
    echo "📅 Modified: $(stat -f "%Sm" "$LATEST_LOG" 2>/dev/null)"
else
    echo "⚠️  No log files found - waiting for bot..."
fi
echo ""
echo "Press Ctrl+C to exit"
echo ""
sleep 2

# Main dashboard loop
while true; do
    clear

    # Get current data
    BOT_INFO=$(get_bot_info)
    BOT_PID=$(echo "$BOT_INFO" | cut -d'|' -f1)
    BOT_UPTIME=$(echo "$BOT_INFO" | cut -d'|' -f2)
    BOT_MEMORY=$(echo "$BOT_INFO" | cut -d'|' -f3)
    BOT_CPU=$(echo "$BOT_INFO" | cut -d'|' -f4)

    MARKET_REGIME=$(get_text_value "Detected:\s+([A-Z_]+)")
    VOLATILITY=$(get_text_value "4h Volatility:\s+([0-9.]+)%")
    CURRENT_PRICE=$(get_text_value "Current Price:\s+([0-9.]+)")
    CURRENT_STRATEGY=$(get_text_value "Selected Strategy:\s+([a-zA-Z_]+)")

    PORTFOLIO_VALUE=$(get_text_value "Portfolio value.*\\\$([0-9,]+\.[0-9]+)")
    USDT_BALANCE=$(get_text_value "([0-9,]+\.[0-9]+).*USDT")
    BNB_BALANCE=$(get_text_value "([0-9,]+\.[0-9]+).*BNB")

    # NEW: Get accurate counts from ALL log files and shadow data
    TOTAL_TRADES=$(get_total_trades)
    ACTIVE_POSITIONS=$(get_active_positions)
    SHADOW_ENTRIES=$(get_shadow_entries)
    WIN_LOSS=$(get_win_loss_stats)
    WINNING_TRADES=$(echo "$WIN_LOSS" | cut -d'|' -f1)
    LOSING_TRADES=$(echo "$WIN_LOSS" | cut -d'|' -f2)
    WIN_RATE=$(echo "$WIN_LOSS" | cut -d'|' -f3)
    COMPLETED_TRADES=$(echo "$WIN_LOSS" | cut -d'|' -f4)

    # Error counts from all files
    ERROR_COUNT=$(grep -h '"level":"error"' $LOG_FILES 2>/dev/null | wc -l | tr -d ' ')
    WARNING_COUNT=$(grep -h '"level":"warn"' $LOG_FILES 2>/dev/null | wc -l | tr -d ' ')

    # Get dynamic threshold info from all files
    DYNAMIC_THRESHOLD=$(grep -h "DYNAMIC-THRESHOLD" $LOG_FILES 2>/dev/null | tail -1)

    echo -e "${CYAN}════════════════════════════════════════════════════════════════${NC}"
    echo -e "${WHITE}          BSC TRADING BOT - PROFESSIONAL DASHBOARD${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════════════════════${NC}"
    echo -e "$(date '+%Y-%m-%d %H:%M:%S') | Multi-File Log Parsing"
    echo ""

    # [1] BOT STATUS
    echo -e "${WHITE}[1] BOT STATUS${NC}"
    echo -e "${BLUE}────────────────────────────────────────────────────────────────${NC}"
    if [ "$BOT_PID" != "N/A" ]; then
        echo -e "  Status:      ${GREEN}● RUNNING${NC}"
        echo -e "  PID:         ${CYAN}$BOT_PID${NC}"
        echo -e "  Uptime:      ${YELLOW}$BOT_UPTIME${NC}"
        echo -e "  Memory:      ${BLUE}$BOT_MEMORY${NC}"
        echo -e "  CPU:         ${BLUE}$BOT_CPU${NC}"
    else
        echo -e "  Status:      ${RED}● STOPPED${NC}"
    fi
    echo ""

    # [2] MARKET CONDITIONS
    echo -e "${WHITE}[2] MARKET CONDITIONS${NC}"
    echo -e "${BLUE}────────────────────────────────────────────────────────────────${NC}"
    if [ "$MARKET_REGIME" != "N/A" ]; then
        # Color code regime
        case $MARKET_REGIME in
            "VERY_LOW") REGIME_COLOR=$GRAY ;;
            "LOW") REGIME_COLOR=$YELLOW ;;
            "MEDIUM") REGIME_COLOR=$BLUE ;;
            "HIGH") REGIME_COLOR=$GREEN ;;
            *) REGIME_COLOR=$WHITE ;;
        esac

        echo -e "  Regime:      ${REGIME_COLOR}$MARKET_REGIME${NC}"
        echo -e "  Volatility:  ${YELLOW}$VOLATILITY${NC}"
        echo -e "  Price:       ${GREEN}\$${CURRENT_PRICE}${NC}"
        echo -e "  Strategy:    ${CYAN}$CURRENT_STRATEGY${NC}"
    else
        echo -e "  ${GRAY}Waiting for market data...${NC}"
    fi
    echo ""

    # [3] PORTFOLIO STATUS
    echo -e "${WHITE}[3] PORTFOLIO STATUS${NC}"
    echo -e "${BLUE}────────────────────────────────────────────────────────────────${NC}"
    if [ "$PORTFOLIO_VALUE" != "N/A" ]; then
        echo -e "  Total Value: ${GREEN}\$${PORTFOLIO_VALUE}${NC}"
        echo -e "  USDT:        ${BLUE}$USDT_BALANCE${NC}"
        echo -e "  BNB:         ${BLUE}$BNB_BALANCE${NC}"

        # Calculate BNB percentage if we have both balances
        if [[ "$USDT_BALANCE" =~ ^[0-9.]+$ ]] && [[ "$BNB_BALANCE" =~ ^[0-9.]+$ ]] && [ "$USDT_BALANCE" != "0" ] && [ "$CURRENT_PRICE" != "N/A" ]; then
            BNB_VALUE=$(echo "scale=2; $BNB_BALANCE / $CURRENT_PRICE" | bc 2>/dev/null)
            TOTAL_VALUE=$(echo "scale=2; $USDT_BALANCE + $BNB_VALUE" | bc 2>/dev/null)
            if [ "$TOTAL_VALUE" != "0" ] && [ -n "$TOTAL_VALUE" ]; then
                BNB_PERCENT=$(echo "scale=1; ($BNB_VALUE / $TOTAL_VALUE) * 100" | bc 2>/dev/null)
                echo -e "  Allocation:  ${CYAN}BNB ${BNB_PERCENT}%${NC} (target 35-45%)"

                # Show allocation status
                if (( $(echo "$BNB_PERCENT >= 35 && $BNB_PERCENT <= 45" | bc -l 2>/dev/null || echo "0") )); then
                    echo -e "  Balance:     ${GREEN}✅ OPTIMAL${NC}"
                else
                    echo -e "  Balance:     ${YELLOW}⚠️  REBALANCE NEEDED${NC}"
                fi
            fi
        fi
    else
        echo -e "  ${GRAY}Waiting for portfolio data...${NC}"
    fi
    echo ""

    # [4] TRADING ACTIVITY - ACCURATE SHADOW MODE METRICS!
    echo -e "${WHITE}[4] TRADING ACTIVITY${NC}"
    echo -e "${BLUE}────────────────────────────────────────────────────────────────${NC}"
    echo -e "  Trading Decisions: ${CYAN}$TOTAL_TRADES${NC}  ${GRAY}(signals analyzed)${NC}"
    echo -e "  Shadow Entries:    ${PURPLE}$SHADOW_ENTRIES${NC}  ${GRAY}(recorded entries)${NC}"
    echo -e "  Active Positions:  ${YELLOW}$ACTIVE_POSITIONS${NC}"

    # Show completed trades with profit/loss tracking
    if [ "$COMPLETED_TRADES" -gt 0 ]; then
        echo -e "  Completed Trades:  ${WHITE}$COMPLETED_TRADES${NC}"
        echo -e "  Winning Trades:    ${GREEN}$WINNING_TRADES${NC}"
        echo -e "  Losing Trades:     ${RED}$LOSING_TRADES${NC}"
        echo -e "  Win Rate:          ${CYAN}${WIN_RATE}%${NC}"
        echo -e "  Data Source:       ${GRAY}📊 Database (Live Trades)${NC}"
    else
        echo -e "  Completed Trades:  ${GRAY}0${NC}"
        echo -e "  Mode:              ${PURPLE}👻 Shadow Trading${NC}"
        echo -e "  Note:              ${GRAY}Entry signals only, no exit tracking${NC}"
    fi

    # Trading status
    if [ "$COMPLETED_TRADES" -gt 0 ] && [ "$ACTIVE_POSITIONS" -gt 0 ]; then
        echo -e "  Status:            ${GREEN}✅ ACTIVELY TRADING${NC}"
    elif [ "$COMPLETED_TRADES" -gt 0 ]; then
        echo -e "  Status:            ${BLUE}⏸️  BETWEEN POSITIONS${NC}"
    elif [ "$SHADOW_ENTRIES" -gt 0 ]; then
        echo -e "  Status:            ${PURPLE}👻 SHADOW MODE (Entries Only)${NC}"
    elif [ "$MARKET_REGIME" = "VERY_LOW" ] || [ "$VOLATILITY" = "0.20%" ] || [ "$VOLATILITY" = "0.17%" ]; then
        echo -e "  Status:            ${YELLOW}⏸️  WAITING FOR VOLATILITY${NC}"
        echo -e "  ${GRAY}Current: $VOLATILITY | Required: 0.30%+${NC}"
    else
        echo -e "  Status:            ${GREEN}✅ READY TO TRADE${NC}"
    fi
    echo ""

    # [5] ENHANCEMENT VALIDATION
    echo -e "${WHITE}[5] ENHANCEMENT VALIDATION${NC}"
    echo -e "${BLUE}────────────────────────────────────────────────────────────────${NC}"
    if [ -n "$DYNAMIC_THRESHOLD" ]; then
        echo -e "  ${GREEN}✅ Dynamic Thresholds: WORKING${NC}"
        echo "$DYNAMIC_THRESHOLD" | python3 -c "
import sys, json
try:
    line = sys.stdin.read().strip()
    data = json.loads(line)
    msg = data.get('message', '')
    print(f'  {msg}')
except:
    pass
" 2>/dev/null
    else
        echo -e "  ${GRAY}⏳ Dynamic Thresholds: Waiting for first trade${NC}"
    fi
    echo ""

    # [6] SYSTEM HEALTH
    echo -e "${WHITE}[6] SYSTEM HEALTH${NC}"
    echo -e "${BLUE}────────────────────────────────────────────────────────────────${NC}"

    # Error status
    if [ "$ERROR_COUNT" -eq "0" ]; then
        echo -e "  Errors:   ${GREEN}$ERROR_COUNT ✅${NC}"
    else
        echo -e "  Errors:   ${RED}$ERROR_COUNT ❌${NC}"
    fi

    # Warning status (volatility warnings are normal)
    if [ "$WARNING_COUNT" -lt "10" ]; then
        echo -e "  Warnings: ${GREEN}$WARNING_COUNT ✅${NC}"
    elif [ "$WARNING_COUNT" -lt "50" ]; then
        echo -e "  Warnings: ${YELLOW}$WARNING_COUNT ⚠️${NC}"
    else
        echo -e "  Warnings: ${YELLOW}$WARNING_COUNT 🔥${NC}"
    fi
    echo -e "  ${GRAY}(Most warnings are 'waiting for volatility')${NC}"
    echo ""

    # [7] RECENT ACTIVITY
    echo -e "${WHITE}[7] RECENT ACTIVITY${NC}"
    echo -e "${BLUE}────────────────────────────────────────────────────────────────${NC}"

    # Get recent meaningful activities from ALL files
    if [ -n "$LOG_FILES" ]; then
        RECENT_ACTIVITY=$(tail -50 $LOG_FILES 2>/dev/null | \
            grep -E "Overriding HOLD|Creating position|Volatility too low|REGIME.*Detected|Confidence.*maintained" | \
            tail -3)

        if [ -n "$RECENT_ACTIVITY" ]; then
            echo "$RECENT_ACTIVITY" | while read -r line; do
                # Extract timestamp
                TIMESTAMP=$(echo "$line" | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}' | head -1)

                # Color code the activity
                if echo "$line" | grep -q "Overriding HOLD"; then
                    echo -e "  ${GREEN}✅ $TIMESTAMP: Strategy override${NC}"
                elif echo "$line" | grep -q "Creating position"; then
                    echo -e "  ${BLUE}💰 $TIMESTAMP: Position created${NC}"
                elif echo "$line" | grep -q "Volatility too low"; then
                    echo -e "  ${YELLOW}⏸️  $TIMESTAMP: Waiting for volatility${NC}"
                elif echo "$line" | grep -q "REGIME"; then
                    echo -e "  ${CYAN}📊 $TIMESTAMP: Regime detected${NC}"
                elif echo "$line" | grep -q "Confidence maintained"; then
                    echo -e "  ${GREEN}🎯 $TIMESTAMP: Confidence maintained${NC}"
                fi
            done
        else
            echo -e "  ${GRAY}No recent trading activity${NC}"
        fi
    else
        echo -e "  ${RED}No log files found${NC}"
    fi
    echo ""

    echo -e "${CYAN}════════════════════════════════════════════════════════════════${NC}"
    echo -e "${WHITE}Dashboard: Multi-File Parsing | Bot: $BOT_PID | Updates: 30s${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════════════════════${NC}"

    sleep 30
done
