# ═══════════════════════════════════════════════════════════════
# algoQbot Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# BSC NETWORK CONFIGURATION
# ═══════════════════════════════════════════════════════════════
BSC_CHAIN_ID=56

# ═══════════════════════════════════════════════════════════════
# RPC PROVIDERS - MULTI-ENDPOINT FAILOVER SYSTEM
# ═══════════════════════════════════════════════════════════════
# The bot uses MultiRPCProvider for automatic failover between 5 endpoints
# Priority order: NodeReal → Binance Public → Binance Backup 1 → Binance Backup 2 → Ankr
#
# ⚡ Expected Results:
#   - 95%+ uptime (vs 70-80% with single endpoint)
#   - <5 RPC errors per day (vs 200+ errors)
#   - Automatic failover in <3 seconds
#   - Health monitoring with hourly reports
#
# 🔧 How It Works:
#   1. Tries primary endpoint (NodeReal - fastest)
#   2. On timeout/error, automatically fails over to next endpoint
#   3. Tracks success/failure rates for each endpoint
#   4. Uses exponential backoff (1s, 2s, 4s) for retries
#   5. Logs health stats every hour
#
# ═══════════════════════════════════════════════════════════════

# Priority 1: NodeReal (Recommended - Free tier with 350M compute units/month)
# Sign up at https://nodereal.io for free API key
NODEREAL_RPC_URL=https://bsc-mainnet.nodereal.io/v1/YOUR_API_KEY_HERE

# Priority 2-4: Binance Public Endpoints (Free, no API key needed)
BSC_RPC_URL=https://bsc-dataseed1.binance.org
BSC_RPC_URL_2=https://bsc-dataseed2.binance.org
BSC_RPC_URL_3=https://bsc-dataseed3.binance.org

# Priority 5: Ankr Public (Free, good failover)
ANKR_RPC_URL=https://rpc.ankr.com/bsc

# Alternative Free RPC Providers (can replace ANKR_RPC_URL):
# - GetBlock: https://bsc.getblock.io/mainnet/ (requires API key)
# - QuickNode: https://example.bsc.quiknode.pro/ (requires API key)
# - Binance 4th backup: https://bsc-dataseed4.binance.org

# RPC Configuration
RPC_TIMEOUT=30000                # 30 second timeout per request
RPC_MAX_RETRIES=3                # Retry 3 times before failover
RPC_FAILOVER_THRESHOLD=5         # Fail over after 5 consecutive errors

# ═══════════════════════════════════════════════════════════════
# WALLET CONFIGURATION (⚠️ KEEP SECURE!)
# ═══════════════════════════════════════════════════════════════
WALLET_ADDRESS=0xYourWalletAddressHere
PRIVATE_KEY=YourPrivateKeyHere

# ⚠️  SECURITY WARNINGS:
# - NEVER commit your actual .env file to Git
# - NEVER share your private key with anyone
# - NEVER use your main wallet for testing
# - Use a dedicated trading wallet with limited funds

# ═══════════════════════════════════════════════════════════════
# AI API KEYS
# ═══════════════════════════════════════════════════════════════
# Anthropic Claude API (REQUIRED for AI strategy selection)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API (OPTIONAL - for future ML features)
OPENAI_API_KEY=sk-your-openai-key-here

# ═══════════════════════════════════════════════════════════════
# TRADING CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# Starting capital
INITIAL_BUDGET=60000

# Trade size limits
MIN_TRADE_AMOUNT=100
MAX_TRADE_AMOUNT=10500

# Trading pair
TRADING_PAIR=USDT/BNB
BASE_TOKEN=USDT
QUOTE_TOKEN=BNB

# ═══════════════════════════════════════════════════════════════
# RISK MANAGEMENT
# ═══════════════════════════════════════════════════════════════
# Maximum daily loss (USD)
DAILY_LOSS_LIMIT=3000

# Maximum position size as percentage of portfolio
MAX_POSITION_SIZE=0.15

# Maximum portfolio drawdown
MAX_DRAWDOWN=0.15

# Maximum consecutive losses before circuit breaker
MAX_CONSECUTIVE_LOSSES=5

# Portfolio balancing thresholds (BNB percentage)
TARGET_BNB_PERCENT_MIN=35
TARGET_BNB_PERCENT_MAX=45

# ═══════════════════════════════════════════════════════════════
# SHADOW MODE (For Testing)
# ═══════════════════════════════════════════════════════════════
# Enable shadow mode (virtual trading without real transactions)
SHADOW_MODE_ENABLED=true

# Record shadow trades to file
SHADOW_MODE_RECORD=true
SHADOW_MODE_RECORD_PATH=./data/shadow_trades.json

