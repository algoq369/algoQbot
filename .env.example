ENABLE_ARBITRAGE=false

# ═══════════════════════════════════════════════════════════════
# VOLATILITY REGIME THRESHOLDS (%)
# ═══════════════════════════════════════════════════════════════
REGIME_VERY_LOW_THRESHOLD=0.3
REGIME_LOW_THRESHOLD=0.8
REGIME_MEDIUM_THRESHOLD=2.0

# ═══════════════════════════════════════════════════════════════
# CONFIDENCE THRESHOLDS (By Regime)
# ═══════════════════════════════════════════════════════════════
CONFIDENCE_VERY_LOW_REGIME=45
CONFIDENCE_LOW_REGIME=55
CONFIDENCE_MEDIUM_REGIME=65
CONFIDENCE_HIGH_REGIME=70

# ═══════════════════════════════════════════════════════════════
# PROFESSIONAL TP/SL STANDARDS (BSC-Optimized)
# ═══════════════════════════════════════════════════════════════
# ⚠️  BSC ROUND-TRIP COSTS: 2.5-3.5%
#    - Entry swap: ~1.2-1.8% (0.25% DEX fee + 1% slippage + gas)
#    - Exit swap:  ~1.2-1.8% (0.25% DEX fee + 1% slippage + gas)
#    - Total cost: ~2.5-3.5% per complete trade
#
# PROFESSIONAL MINIMUMS (automatically enforced in code):
#    - Minimum TP: 3.5% (covers 2.5% costs + 1% profit)
#    - Minimum SL: 1.5% (ATR-based risk protection)
#
# REGIME-SPECIFIC TP/SL (defined in config/volatilityRegimes.js):
#    HIGH   (>2% vol):   TP ≥ 4.0%, SL ≥ 2.0%
#    MEDIUM (0.8-2% vol): TP ≥ 3.5%, SL ≥ 1.5%
#    LOW    (0.3-0.8% vol): TP ≥ 3.5%, SL ≥ 1.5%
#    VERY_LOW (<0.3% vol): No trading
#
# 📊 These values are HARDCODED for safety and cannot be overridden via .env
# 📊 Any TP < 3.5% will result in guaranteed losses due to BSC costs

# ═══════════════════════════════════════════════════════════════
# PERFORMANCE OPTIMIZATION
# ═══════════════════════════════════════════════════════════════
# Price cache TTL (seconds)
PRICE_CACHE_TTL=30

# Enable performance tracking
ENABLE_PERFORMANCE_TRACKING=true

# Performance log interval (milliseconds)
PERFORMANCE_LOG_INTERVAL=60000

# ═══════════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ═══════════════════════════════════════════════════════════════
LOG_LEVEL=info
LOG_FILE=logs/bot.log
LOG_MAX_FILES=14
LOG_MAX_SIZE=20m

# Log levels: error, warn, info, debug, verbose
# Recommended for production: info
# Recommended for development: debug

# ═══════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════
DATABASE_PATH=./data/trading_bot.db
ENABLE_DATABASE=true

# ═══════════════════════════════════════════════════════════════
# MONITORING DASHBOARD
# ═══════════════════════════════════════════════════════════════
DASHBOARD_REFRESH_INTERVAL=10

# ═══════════════════════════════════════════════════════════════
# ADVANCED SETTINGS (⚠️ DO NOT CHANGE UNLESS YOU KNOW WHAT YOU'RE DOING)
# ═══════════════════════════════════════════════════════════════
# Gas limit multiplier
GAS_LIMIT_MULTIPLIER=1.2

# Gas price multiplier (for faster transactions)
GAS_PRICE_MULTIPLIER=1.1

# Maximum slippage tolerance (%)
MAX_SLIPPAGE=1.0

# Transaction deadline (seconds)
TX_DEADLINE=300

# Retry attempts for failed transactions
TX_RETRY_ATTEMPTS=3

# Retry delay (milliseconds)
TX_RETRY_DELAY=5000

# ═══════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════
